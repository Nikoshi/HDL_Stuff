{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "HDL: Alle Tests (Nix)",
      "type": "shell",
      "command": "nix",
      "args": [
        "develop",
        "--command",
        "make",
        "test"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    }
  ]
}
