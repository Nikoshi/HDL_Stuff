{
  "folders": [
    {
      "path": "logic_basics",
      "name": "logic_basics (Spade)"
    }
  ],
  "settings": {
    "spade-lsp.serverCommand": "nix",
    "spade-lsp.serverArgs": [
      "develop",
      "..",
      "-c",
      "swim",
      "lsp"
    ]
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "HDL: Regression (alle abgeschlossenen Tests)",
        "type": "shell",
        "command": "nix",
        "args": [
          "develop",
          "--command",
          "make",
          "test_completed"
        ],
        "options": {
          "cwd": "${workspaceFolder}/.."
        },
        "group": {
          "kind": "test",
          "isDefault": true
        },
        "presentation": {
          "reveal": "always",
          "panel": "shared",
          "clear": true
        },
        "problemMatcher": []
      },
      {
        "label": "HDL: Einzeltest auswählen",
        "type": "shell",
        "command": "nix",
        "args": [
          "develop",
          "--command",
          "make",
          "${input:hdlTestTarget}"
        ],
        "options": {
          "cwd": "${workspaceFolder}/.."
        },
        "group": "test",
        "presentation": {
          "reveal": "always",
          "panel": "shared",
          "clear": true
        },
        "problemMatcher": []
      },
      {
        "label": "HDL: Alle Tests (Nix)",
        "type": "shell",
        "command": "nix",
        "args": [
          "develop",
          "--command",
          "make",
          "test"
        ],
        "options": {
          "cwd": "${workspaceFolder}/.."
        },
        "group": "test",
        "presentation": {
          "reveal": "always",
          "panel": "shared",
          "clear": true
        },
        "problemMatcher": []
      },
      {
        "label": "HDL: Abgeschlossene Tests (Nix)",
        "type": "shell",
        "command": "nix",
        "args": [
          "develop",
          "--command",
          "make",
          "test_completed"
        ],
        "options": {
          "cwd": "${workspaceFolder}/.."
        },
        "group": "test",
        "presentation": {
          "reveal": "always",
          "panel": "shared",
          "clear": true
        },
        "problemMatcher": []
      },
      {
        "label": "HDL: ALU-Synthese (Yosys)",
        "type": "shell",
        "command": "nix",
        "args": [
          "develop",
          "--command",
          "make",
          "synth_alu4"
        ],
        "options": {
          "cwd": "${workspaceFolder}/.."
        },
        "group": "build",
        "presentation": {
          "reveal": "always",
          "panel": "shared",
          "clear": true
        },
        "problemMatcher": []
      },
      {
        "label": "HDL: ALU-Variantenvergleich (Yosys)",
        "type": "shell",
        "command": "nix",
        "args": [
          "develop",
          "--command",
          "make",
          "compare_alu4"
        ],
        "options": {
          "cwd": "${workspaceFolder}/.."
        },
        "group": "build",
        "presentation": {
          "reveal": "always",
          "panel": "shared",
          "clear": true
        },
        "problemMatcher": []
      },
      {
        "label": "Assembler: Encoder testen (abgeschlossen)",
        "type": "shell",
        "command": "nix",
        "args": [
          "develop",
          "--command",
          "make",
          "test_assembler_encoder"
        ],
        "options": {
          "cwd": "${workspaceFolder}/.."
        },
        "group": "test",
        "presentation": {
          "reveal": "always",
          "panel": "shared",
          "clear": true
        },
        "problemMatcher": []
      },
      {
        "label": "Assembler: CLI bauen (Platzhalter)",
        "type": "shell",
        "command": "nix",
        "args": [
          "develop",
          "--command",
          "make",
          "assembler"
        ],
        "options": {
          "cwd": "${workspaceFolder}/.."
        },
        "group": "build",
        "presentation": {
          "reveal": "always",
          "panel": "shared",
          "clear": true
        },
        "problemMatcher": []
      },
      {
        "label": "Assembler: Parser testen (aktuelle Übung)",
        "type": "shell",
        "command": "nix",
        "args": [
          "develop",
          "--command",
          "make",
          "test_assembler_parser"
        ],
        "options": {
          "cwd": "${workspaceFolder}/.."
        },
        "group": "test",
        "presentation": {
          "reveal": "always",
          "panel": "shared",
          "clear": true
        },
        "problemMatcher": []
      }
    ],
    "inputs": [
      {
        "id": "hdlTestTarget",
        "type": "pickString",
        "description": "Welchen HDL-Test möchtest du ausführen?",
