            "value": "test_full_adder"
          },
          {
            "label": "Halbaddierer",
            "value": "test_half_adder"
          },
          {
            "label": "Multiplexer",
            "value": "test_mux"
          }
        ],
        "default": "test_assembler_parser"
      }
    ]
  }
}
