// Kombinatorischer Decoder für das erste 6-Bit-Befehlsformat.
// instruction[5:4] = ALU-Operation, instruction[3:0] = Immediate.
// Beide Ausgänge sind nur umgruppierte Leitungen, keine Rechenoperation.
#[no_mangle(all)]
pub entity decoder6_top(
    instruction: uint<6>,
    op: inv uint<2>,
    operand: inv uint<4>
) {
    // as_bits() ordnet die Bits vom niederwertigsten zum höchstwertigen.
    // as_uint() interpretiert das erste Arrayelement wieder als Bit 0.
    let bits = instruction.as_bits();

    set op = [bits[4], bits[5]].as_uint();
    set operand = [bits[0], bits[1], bits[2], bits[3]].as_uint();
}
