use lib::cpu::decoder6;
use lib::cpu::accumulator;

// Ausführungsstufe: Der Decoder trennt den Maschinenbefehl in Opcode
// und Immediate, die der bereits vorhandene Akkumulator verarbeitet.
// Nur der Akkumulator besitzt Zustand; diese Entity fügt kein Register hinzu.
#[no_mangle(all)]
pub entity instruction_exec6_top(
    clk: clock,
    rst: bool,
    enable: bool,
    instruction: uint<6>,
    q: inv uint<4>
) {
    // Jeder inv-Ausgang der Unterbausteine erhält eine eigene Verbindung.
    let (decoded_op, op_wire) = port();
    let (decoded_operand, operand_wire) = port();
    let (acc_value, acc_wire) = port();

    let _ = inst decoder6::decoder6_top(
        instruction,
        op_wire,
        operand_wire
    );

    // Beide Steuerleitungen kommen direkt aus dem kombinatorischen Decoder.
    let _ = inst accumulator::accumulator4_top(
        clk,
        rst,
        enable,
        decoded_operand,
        decoded_op,
        acc_wire
    );

    set q = acc_value;
}
