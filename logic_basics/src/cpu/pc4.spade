// Vierbittiger Programmzähler mit synchronem Reset und absolutem Sprung.
// Der gespeicherte Zustand ändert sich nur an steigenden Taktflanken.
#[no_mangle(all)]
pub entity pc4_top(
    clk: clock,
    rst: bool,
    advance: bool,
    jump: bool,
    target: uint<4>,
    pc: inv uint<4>
) {
    // Reset hat Vorrang; ohne advance bleibt der PC auch bei jump stehen.
    reg(clk) current: uint<4> reset(rst: 0) = if advance && jump {
        target
    } else if advance {
        current +. 1
    } else {
        current
    };

    // Nur den gespeicherten Zustand ausgeben, nicht den nächsten Wert.
    set pc = current;
}
