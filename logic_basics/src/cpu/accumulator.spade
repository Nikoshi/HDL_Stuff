use lib::cpu::alu;

// Erster CPU-Datenpfad: Der gespeicherte ACC-Wert wird als ALU-Eingang
// verwendet. Ein neues Ergebnis gelangt nur an der Taktflanke ins Register.
// Synchroner Reset hat Vorrang vor Enable.
#[no_mangle(all)]
pub entity accumulator4_top(
    clk: clock,
    rst: bool,
    enable: bool,
    b: uint<4>,
    op: uint<2>,
    q: inv uint<4>
) {
    // Vorwärtsdeklaration: Die ALU liest ACC, bevor das Register unten steht.
    decl acc;

    // Lesbare Signalwerte und deren inv-Enden für die ALU-Ausgänge.
    let (alu_result, result_wire) = port();
    // Carry und Zero sind verbunden, werden hier aber noch nicht gespeichert.
    let (_, carry_wire) = port();
    let (_, zero_wire) = port();

    // Reihenfolge wie in der alu4_top-Schnittstelle:
    // a, b, op, result, carry_out, zero
    let _ = inst alu::alu4_top(
        acc,
        b,
        op,
        result_wire,
        carry_wire,
        zero_wire
    );

    // Die ALU arbeitet kombinatorisch; erst dieses Register hält den Wert.
    reg(clk) acc: uint<4> reset(rst: 0) = if enable {
        alu_result
    } else {
        acc
    };

    set q = acc;
}
