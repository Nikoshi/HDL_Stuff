// Halbaddierer ohne Eingangsübertrag: Rückgabewert (Summe, Übertrag).
pub fn half_adder(a: bool, b: bool) -> (bool, bool) {
    (a ^^ b, a && b)
}

// Volladdierer aus zwei Halbaddierern: Beide Teilüberträge werden per OR verknüpft.
// Rückgabewert: (Summe, Ausgangsübertrag).
pub fn full_adder(a: bool, b: bool, carry_in: bool) -> (bool, bool) {
    let (s1, c1) = half_adder(a, b);
    let (s2, c2) = half_adder(s1, carry_in);

    (s2, c1 || c2)
}

// 2-Bit-Ripple-Carry-Addierer: Der Übertrag von Bit 0 fließt in Bit 1.
// Das letzte Übertragsbit wird zum höchstwertigen Ergebnisbit.
pub fn add2(a: uint<2>, b: uint<2>) -> uint<3> {
    let (sum0, carry0) = full_adder(a.lsb(), b.lsb(), false);
    let (sum1, carry1) = full_adder(a.msb(), b.msb(), carry0);

    // as_uint interpretiert das erste Arrayelement als niederwertigstes Bit.
    [sum0, sum1, carry1].as_uint()
}

// 4-Bit-Ripple-Carry-Addierer: Der Übertrag wird durch vier Stufen gereicht.
pub fn add4(a: uint<4>, b: uint<4>) -> uint<5> {
    let a_bits = a.as_bits();
    let b_bits = b.as_bits();

    let (s0, c0) = full_adder(a_bits[0], b_bits[0], false);
    let (s1, c1) = full_adder(a_bits[1], b_bits[1], c0);
    let (s2, c2) = full_adder(a_bits[2], b_bits[2], c1);
    let (s3, c3) = full_adder(a_bits[3], b_bits[3], c2);

    // as_uint interpretiert das erste Arrayelement als niederwertigstes Bit.
    [s0, s1, s2, s3, c3].as_uint()
}
