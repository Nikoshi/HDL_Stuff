// 2:1-Multiplexer: s=0 wählt a, s=1 wählt b.
// no_mangle(all) hält die Signalnamen für die Verilator-Tests stabil.
// inv bool kennzeichnet einen Ausgang, der mit set beschrieben wird.
#[no_mangle(all)]
entity main(a: bool, b: bool, s: bool, y: inv bool) {
    set y = (a && !s) || (b && s);
}

// Test-Entity: macht die beiden Rückgabewerte der Funktion als Ports zugänglich.
#[no_mangle(all)]
entity half_adder_top(a: bool, b: bool, sum: inv bool, carry: inv bool) {
    let (s, c) = half_adder(a, b);

    set sum = s;
    set carry = c;
}

// Test-Entity: macht Summe und Ausgangsübertrag des Volladdierers zugänglich.
#[no_mangle(all)]
entity full_adder_top(a: bool, b: bool, carry_in: bool, sum: inv bool, carry_out: inv bool) {
    let (s, c) = full_adder(a, b, carry_in);

    set sum = s;
    set carry_out = c;
}

// Halbaddierer ohne Eingangsübertrag: Rückgabewert (Summe, Übertrag).
fn half_adder(a: bool, b: bool) -> (bool, bool) {
    (a ^^ b, a && b)
}

// Volladdierer aus zwei Halbaddierern: Beide Teilüberträge werden per OR verknüpft.
// Rückgabewert: (Summe, Ausgangsübertrag).
fn full_adder(a: bool, b: bool, carry_in: bool) -> (bool, bool) {
    let (s1, c1) = half_adder(a, b);
    let (s2, c2) = half_adder(s1, carry_in);

    (s2, c1 || c2)
}

// Test-Entity: stellt das dreibittige Ergebnis als Ausgang für Verilator bereit.
#[no_mangle(all)]
entity add2_top(a: uint<2>, b: uint<2>, sum: inv uint<3>) {
    set sum = add2(a, b);
}

// Zwei 2-Bit-Zahlen addieren; das Ergebnis benötigt drei Bits.
// TODO (TDD): Dieser Platzhalter ist absichtlich falsch und soll den Test scheitern lassen.
// Deine Aufgabe: Hier zwei vorhandene Volladdierer miteinander verbinden.
fn add2(a: uint<2>, b: uint<2>) -> uint<3> {
    let (s1, c1) = full_adder(a.lsb(), b.lsb(), false);
    let (s2, c2) = full_adder(a.msb(), b.msb(), c1);
    
    [s1, s2, c2].as_uint()
}
