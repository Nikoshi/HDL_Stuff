#[no_mangle(all)]
entity main(a: bool, b: bool, s: bool, y: inv bool) {
    set y = (a && !s) || (b && s);
}

#[no_mangle(all)]
entity half_adder_top(a: bool, b: bool, sum: inv bool, carry: inv bool) {
    let (s, c) = half_adder(a, b);

    set sum = s;
    set carry = c;
}

fn half_adder(a: bool, b: bool) -> (bool, bool) {
    (a ^^ b, a && b)
}

