// CPU v2: Kombinatorischer 16×8-Bit-Programmspeicher.
// Die Adresse wählt ein vollständiges 8-Bit-Befehlswort.
// TODO: Das Programm aus docs/cpu_v2/rom16x8.md eintragen.
#[no_mangle(all)]
pub entity rom16x8_top(
    address: uint<4>,
    instruction: inv uint<8>
) {
    // Absichtlicher Platzhalter: NOP an jeder Adresse.
    set instruction = match address {
        0x00 => 0x45,
        0x01 => 0x0F,
        0x02 => 0x95,
        0x03 => 0x81,
        0x04 => 0xC0,
        0x05 => 0x2F,
        0x06 => 0x1A,
        0x07 => 0x3F,
        0x08 => 0xC0,
        0x09 => 0x80,
        // Alle übrigen ROM-Adressen enthalten NOP.
        _    => 0xC0,
    };
}
