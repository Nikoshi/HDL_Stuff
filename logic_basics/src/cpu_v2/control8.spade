// Kombinatorische Steuersignale fuer die 8-Bit-ISA der CPU v2.
// TODO: Den Opcode gemaess der Tabelle in docs/cpu_v2/control8.md decodieren.
// Dieser Baustein speichert keine Zustaende und fuehrt keine ALU-Operation aus.
#[no_mangle(all)]
pub entity control8_top(
    opcode: uint<4>,
    acc_write: inv bool,
    acc_from_imm: inv bool,
    alu_op: inv uint<2>,
    pc_mode: inv uint<2>
) {

    // acc_write, acc_from_imm, alu_op, pc_mode
    let (write, from_imm, op, mode) = match opcode {
        0x0 => ( true, false, 0b00u2, 0b00u2),
        0x1 => ( true, false, 0b01u2, 0b00u2),
        0x2 => ( true, false, 0b10u2, 0b00u2),
        0x3 => ( true, false, 0b11u2, 0b00u2),
        0x4 => ( true,  true, 0b00u2, 0b00u2),
        0x8 => (false, false, 0b00u2, 0b01u2),
        0x9 => (false, false, 0b00u2, 0b10u2),
        0xC => (false, false, 0b00u2, 0b00u2),
        _   => (false, false, 0b00u2, 0b00u2)
    };

    // Noch keine Opcodedecodierung: sichere NOP-Standardwerte.
    // Der TDD-Test muss fuer andere Befehle zunaechst fehlschlagen.
    set acc_write = write;
    set acc_from_imm = from_imm;
    set alu_op = op;
    set pc_mode = mode;
}
