// Kombinatorische Opcode-Decodierung fuer die CPU-v2-Steuersignale.
// Eine fn garantiert hier, dass keine Register oder Entity-Instanzen
// in der Steuerentscheidung verborgen sein koennen.
fn decode_control_signals(opcode: uint<4>) -> (bool, bool, uint<2>, uint<2>) {
    // Rueckgabe: ACC schreiben, Immediate waehlen, ALU-Operation, PC-Modus.
    // Reservierte Opcodes liefern wie NOP sichere Standardsteuersignale.
    match opcode {
            0x0 => ( true, false, 0b00u2, 0b00u2),
            0x1 => ( true, false, 0b01u2, 0b00u2),
            0x2 => ( true, false, 0b10u2, 0b00u2),
            0x3 => ( true, false, 0b11u2, 0b00u2),
            0x4 => ( true,  true, 0b00u2, 0b00u2),
            0x8 => (false, false, 0b00u2, 0b01u2),
            0x9 => (false, false, 0b00u2, 0b10u2),
            0xC => (false, false, 0b00u2, 0b00u2),
            _   => (false, false, 0b00u2, 0b00u2)
}

// Diese duenne Entity behaelt die vorhandene, einzeln testbare
// Verilator-Schnittstelle mit vier benannten Ausgaengen bei.
#[no_mangle(all)]
pub entity control8_top(
    opcode: uint<4>,
    acc_write: inv bool,
    acc_from_imm: inv bool,
    alu_op: inv uint<2>,
    pc_mode: inv uint<2>
) {
    let (write_acc, select_immediate, selected_alu_op, selected_pc_mode) =
        decode_control_signals(opcode);

    set acc_write = write_acc;
    set acc_from_imm = select_immediate;
    set alu_op = selected_alu_op;
    set pc_mode = selected_pc_mode;
}
