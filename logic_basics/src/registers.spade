// 1-Bit-Register mit synchronem, aktiv-hohem Reset.
// q zeigt den gespeicherten Wert, nicht direkt den aktuellen Eingang d.
#[no_mangle(all)]
entity register1_top(clk: clock, rst: bool, d: bool, q: inv bool) {
    reg(clk) stored reset(rst: false) = d;

    set q = stored;
}

// 4-Bit-Register mit synchronem Reset und Enable.
// Ohne Enable wird der bisherige Registerwert zurückgeführt.
#[no_mangle(all)]
entity register4_top(
    clk: clock,
    rst: bool,
    enable: bool,
    d: uint<4>,
    q: inv uint<4>
) {
    reg(clk) stored reset(rst: 0) = if enable {
        d
    } else {
        stored
    };

    set q = stored;
}
