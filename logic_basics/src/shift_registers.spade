// Vierstufiges Links-Schieberegister mit synchronem Reset und Enable.
// Bei jedem aktiven Takt soll serial_in zum niederwertigsten Bit werden.
// TODO (TDD): Noch kein Schieben: Der Platzhalter speichert immer 0.
#[no_mangle(all)]
entity shift4_top(
    clk: clock,
    rst: bool,
    enable: bool,
    serial_in: bool,
    q: inv uint<4>
) {
    reg(clk) stored: uint<4> reset(rst: 0) = if enable {
        let bits = stored.as_bits();
        
        [serial_in, bits[0], bits[1], bits[2]].as_uint()
    } else {
        stored
    };

    set q = stored;
}
